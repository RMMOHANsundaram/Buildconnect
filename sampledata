FROM node:20
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]




call npm install
if errorlevel 1 exit /b 1

call npm run build
if errorlevel 1 exit /b 1




pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install') {
            steps {
                bat 'npm install'
            }
        }

        stage('Build') {
            steps {
                bat 'npm run build'
            }
        }
    }

    post {
        success {
            archiveArtifacts artifacts: 'dist/**',
                             fingerprint: true
        }
    }
}


pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/RMMOHANsundaram/pollandvoting.git'
            }
        }

        stage('Install dependencies') {
            steps {
                dir('pollandvoting') {
                    bat 'npm install'
                }
            }
        }

        stage('Build') {
            steps {
                dir('pollandvoting') {
                    bat 'npm run build'
                }
            }
        }
    }

    post {
        success {
            echo 'React application built successfully'
        }

        failure {
            echo 'React application build failed'
        }
    }
}
