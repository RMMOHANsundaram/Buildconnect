[TEMPLATE]
PORT=5000
MONGODB_URI=mongodb://localhost:27017/buildconnect
JWT_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# --- Payments (Razorpay) ---------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# --- Email (booking accepted / started / completed + the PDF bill) ---------
# For Gmail use a 16-character "App Password", not your normal password:
# Google Account -> Security -> 2-Step Verification -> App passwords
EMAIL_SERVICE=gmail
EMAIL_USER=your-address@gmail.com
EMAIL_PASS=your-16-char-app-password
# Optional: use your own SMTP host instead of EMAIL_SERVICE
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_SECURE=false

# --- WhatsApp --------------------------------------------------------------
# WHATSAPP_PROVIDER=twilio  (default) or "meta" for the WhatsApp Cloud API
WHATSAPP_PROVIDER=twilio
# Twilio (also used for SMS). Sandbox sender: whatsapp:+14155238886
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=+14155238886
TWILIO_PHONE_NUMBER=+15017122661
# Meta WhatsApp Cloud API (only needed when WHATSAPP_PROVIDER=meta)
# WHATSAPP_TOKEN=your-permanent-access-token
# WHATSAPP_PHONE_NUMBER_ID=123456789012345

# --- Business details printed on the PDF bill ------------------------------
COMPANY_NAME=BuildConnect
COMPANY_TAGLINE=Verified home service professionals
COMPANY_ADDRESS=Tamil Nadu, India
COMPANY_EMAIL=support@buildconnect.example
COMPANY_PHONE=+91 00000 00000
COMPANY_GSTIN=
# Country code used when a stored phone number has no prefix (default 91 = India)
DEFAULT_COUNTRY_CODE=91
